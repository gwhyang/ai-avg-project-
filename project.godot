; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="一纸千山"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
Minigames="*res://Minigames/MinigameBridge.gd"
SpeakerFocus="*res://UI/Dialogic/SpeakerFocus.gd"

[dialogic]

directories/dch_directory={
"amei": "res://Charactor/amei.dch",
"aquanbo": "res://Charactor/aquanbo.dch",
"atang": "res://Charactor/atang.dch",
"character": "res://Charactor/character.dch",
"chenshuncheng": "res://Charactor/chenshuncheng.dch",
"elder_villager": "res://Charactor/elder_villager.dch",
"grandma_lindeng": "res://Charactor/grandma_lindeng.dch",
"laisi": "res://Charactor/laisi.dch",
"lindeng": "res://Charactor/lindeng.dch",
"shunbo": "res://Charactor/shunbo.dch",
"soldier": "res://Charactor/soldier.dch",
"widow_li": "res://Charactor/widow_li.dch"
}
directories/dtl_directory={
"chapter_1": "res://Timelines/chapter_1.dtl",
"chapter_2": "res://Timelines/chapter_2.dtl",
"chapter_3": "res://Timelines/chapter_3.dtl",
"chapter_4": "res://Timelines/chapter_4.dtl",
"chapter_5": "res://Timelines/chapter_5.dtl",
"ending_relief": "res://Timelines/ending_relief.dtl",
"ending_return": "res://Timelines/ending_return.dtl",
"ending_south": "res://Timelines/ending_south.dtl",
"ending_steadfast": "res://Timelines/ending_steadfast.dtl",
"ending_unfinished": "res://Timelines/ending_unfinished.dtl",
"modern": "res://Timelines/modern.dtl",
"postwar": "res://Timelines/postwar.dtl",
"timeline": "res://Timelines/timeline.dtl"
}
layout/style_directory={
"": "res://UI/Dialogic/ink_wash_style.tres",
"水墨": "res://UI/Dialogic/ink_wash_style.tres"
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "Master",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Master",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={
"amei_affection": 0,
"aquanbo_bond": 0,
"batch_loss_count": 0,
"father_letter": false,
"father_roll": 0,
"joined_relief_batch": false,
"minigame_choice": -1,
"minigame_retried": false,
"minigame_reward": 0.0,
"minigame_success": false,
"shunbo_trust": 0,
"used_batch_money": false,
"widow_li_batch_lost": false
}
layout/style_list=["res://UI/Dialogic/ink_wash_style.tres"]
layout/default_style="res://UI/Dialogic/ink_wash_style.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom="res://UI/Theme/ink_theme.tres"

